// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  description  String
  client       String?
  categories   String[] @default(["UI/UX Design", "Brand Identity", "Web Development", "Marketing Graphics"])
  thumbnailUrl String?
  galleryUrls  String[]
  isPublished  Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @default("David Caleb")
  headline       String   @default("We build websites that bring real customers")
  subtext        String   @default("I’m David Caleb, I help small businesses grow online with clean, modern websites")
  profileImage   String   @default("/images/profile.jpg")
  whatsappNumber String   @default("+2349045729555")
  showWhatsApp   Boolean  @default(true)
  showRateService Boolean @default(true)
  contactEmail   String?
  githubUrl      String?
  linkedinUrl    String?
  createdAt      DateTime? @default(now())
}

model Inquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @default("Client")
  company   String   @default("Verified Review")
  text      String
  rating    Float    @default(5)
  imageUrl  String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  price     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AboutSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  bio       String
  mission   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcessStep {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResumeData {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName    String
  role        String
  summary     String
  experiences Json
  education   Json
  skills      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
