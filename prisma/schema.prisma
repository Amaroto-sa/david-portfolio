// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  description  String
  client       String?
  categories   String[] @default(["UI/UX Design", "Brand Identity", "Web Development", "Marketing Graphics"])
  thumbnailUrl String?
  galleryUrls  String[]
  isPublished  Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @default("David Caleb")
  headline       String   @default("We build websites that bring real customers")
  subtext        String   @default("I’m David Caleb, I help small businesses grow online with clean, modern websites")
  profileImage   String   @default("/images/profile.jpg")
  whatsappNumber String   @default("+2349045729555")
  updatedAt      DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @default("Client")
  company   String   @default("Verified Review")
  text      String
  rating    Int      @default(5)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
