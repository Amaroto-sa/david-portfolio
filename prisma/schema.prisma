// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  description  String
  client       String?
  categories   String[] @default(["UI/UX Design", "Brand Identity", "Web Development", "Marketing Graphics"])
  thumbnailUrl String?
  galleryUrls  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @default("David Caleb")
  headline       String   @default("Welcome to My\nDesign Portfolio")
  subtext        String   @default("Work with me today")
  profileImage   String   @default("/images/profile.jpg")
  whatsappNumber String   @default("+2349045729555")
  updatedAt      DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
