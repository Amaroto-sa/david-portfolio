// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  slug         String   @unique
  description  String
  client       String?
  categories   String[] @default(["UI/UX Design", "Brand Identity", "Web Development", "Marketing Graphics"])
  thumbnailUrl String?
  galleryUrls  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
